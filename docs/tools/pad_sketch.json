{
  "name": "pad_sketch",
  "description": "Create a native PartDesign Pad from a named closed sketch. Use after new_sketch and sketch geometry tools.",
  "permission": "confirm",
  "apps": ["freecad"],
  "args_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sketch_name", "length"],
    "properties": {
      "sketch_name": {
        "type": "string",
        "minLength": 1,
        "description": "Existing Sketcher sketch name or label."
      },
      "length": { "type": "number", "exclusiveMinimum": 0 },
      "midplane": { "type": "boolean", "default": false },
      "reversed": { "type": "boolean", "default": false },
      "name": {
        "type": "string",
        "minLength": 1,
        "default": "Pad"
      }
    }
  }
}
