{
  "name": "sketch_rectangle",
  "description": "Add one constrained rectangle to a named empty FreeCAD sketch. x and y are the lower-left corner in sketch coordinates; dimensions are millimetres.",
  "permission": "confirm",
  "apps": ["freecad"],
  "args_schema": {
    "type": "object",
    "additionalProperties": false,
    "required": ["sketch_name", "width", "height"],
    "properties": {
      "sketch_name": {
        "type": "string",
        "minLength": 1,
        "description": "Existing Sketcher sketch name or label."
      },
      "x": {
        "type": "number",
        "default": 0,
        "description": "Lower-left X coordinate in millimetres."
      },
      "y": {
        "type": "number",
        "default": 0,
        "description": "Lower-left Y coordinate in millimetres."
      },
      "width": { "type": "number", "exclusiveMinimum": 0 },
      "height": { "type": "number", "exclusiveMinimum": 0 }
    }
  }
}
