# Copy this file to `.env` at the repo root (gitignored) and fill values.
# Real environment variables always win over this file.

# --- Optional OpenRouter cloud lane (ADR-010) ---
FIXTURE_OPENROUTER_API_KEY=
# FIXTURE_ACCURATE_MODEL=openrouter:deepseek/deepseek-v4.1-flash
# FIXTURE_FAST_MODEL=openrouter:z-ai/glm-5.3-flash

